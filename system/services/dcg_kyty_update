#!/bin/bash
# Vérifie l'intégration et les releases Kyty au démarrage de Batocera.

REPO_API="https://api.github.com/repos/DreamerCG/kyty-batocera/contents"
VERSION_FILE="/userdata/system/ps5/VERSION.txt"
LOG="/userdata/system/logs/kyty_update.log"
DEST="/userdata"
DOWNLOAD_ATTEMPTS=5

log() { echo "$(date '+%F %T') $*"; }
ok() { log "$*"; }
warn() { log "ATTENTION : $*"; }
fail() { log "ERREUR : $*"; exit 1; }

download() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -H 'Accept: application/vnd.github.raw+json' \
            --connect-timeout 10 --max-time 60 "$1" -o "$2"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --header='Accept: application/vnd.github.raw+json' -T 60 -O "$2" "$1"
    else
        log "ERREUR : curl ou wget est nécessaire"
        return 1
    fi
}

download_url() {
    local url="$1" dest="$2" label="$3" attempt=1
    command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 \
        || fail "ni curl ni wget n'est disponible pour télécharger $label"

    while [ "$attempt" -le "$DOWNLOAD_ATTEMPTS" ]; do
        rm -f "$dest"
        if command -v curl >/dev/null 2>&1; then
            curl -fsL --retry 2 --retry-delay 2 --connect-timeout 20 \
                -H 'Accept: application/vnd.github+json' \
                -o "$dest" "$url" || rm -f "$dest"
        else
            wget -q -T 30 -O "$dest" "$url" || rm -f "$dest"
        fi

        if [ -s "$dest" ]; then
            return 0
        fi
        rm -f "$dest"
        if [ "$attempt" -lt "$DOWNLOAD_ATTEMPTS" ]; then
            warn "Échec du téléchargement de $label (tentative $attempt/$DOWNLOAD_ATTEMPTS), nouvel essai..."
            sleep $((attempt * 2))
        fi
        attempt=$((attempt + 1))
    done
    return 1
}

install_emulator_release() {
    local name="$1" api_url="$2" target="$3" json_file metadata
    local release_tag asset_url digest release_digest asset_file stage version_file version_tmp actual_digest executable
    json_file="$WORK/$name-release.json"
    download_url "$api_url" "$json_file" "les informations de release $name" \
        || fail "impossible de récupérer la dernière release de $name"

    metadata="$(python3 - "$json_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as release_file:
    release = json.load(release_file)

assets = [
    asset
    for asset in release.get("assets", [])
    if asset.get("name", "").endswith("Linux-x86_64.tar.gz")
]
if len(assets) != 1:
    raise SystemExit("la release doit contenir exactement une archive Linux-x86_64.tar.gz")

tag = release.get("tag_name")
url = assets[0].get("browser_download_url")
digest = assets[0].get("digest") or ""
if not tag or not url:
    raise SystemExit("la release ne contient pas de tag ou d'URL de téléchargement")
print(f"{tag}\t{url}\t{digest}")
PY
    )" || fail "métadonnées de release invalides pour $name"
    IFS=$'\t' read -r release_tag asset_url digest <<< "$metadata"
    [ -n "$release_tag" ] && [ -n "$asset_url" ] \
        || fail "tag ou URL absent dans les métadonnées de release $name"
    release_digest="$digest"

    version_file="$target/.release-version"
    if [ -f "$version_file" ] \
        && [ "$(sed -n '1p' "$version_file")" = "$release_tag" ] \
        && [ "$(sed -n '2p' "$version_file")" = "$release_digest" ] \
        && [ -x "$target/kyty_emulator" ] \
        && [ -x "$target/kyty_launcher" ] \
        && { [ "$name" != "KytyPS5-U59" ] || [ -f "$target/u59-preset.json" ]; }; then
        ok "$name déjà à jour ($release_tag), téléchargement ignoré"
        return 0
    fi

    asset_file="$WORK/$name-Linux-x86_64.tar.gz"
    download_url "$asset_url" "$asset_file" "l'archive Linux de $name" \
        || fail "téléchargement de l'archive Linux de $name impossible"
    gzip -t "$asset_file" || fail "archive Linux invalide ou incomplète pour $name"

    if [ -n "$digest" ]; then
        case "$digest" in
            sha256:*) digest="${digest#sha256:}" ;;
            *) fail "type de checksum non pris en charge pour $name : $digest" ;;
        esac
        actual_digest="$(python3 - "$asset_file" <<'PY'
import hashlib
import sys

digest = hashlib.sha256()
with open(sys.argv[1], "rb") as archive:
    for chunk in iter(lambda: archive.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
        )" || fail "vérification SHA-256 impossible pour $name"
        [ "$actual_digest" = "$digest" ] \
            || fail "checksum SHA-256 incorrect pour l'archive de $name"
    fi

    stage="$WORK/$name"
    mkdir -p "$stage" || fail "création du dossier temporaire impossible pour $name"
    tar -xzf "$asset_file" -C "$stage" \
        || fail "extraction de l'archive Linux impossible pour $name"
    for executable in kyty_emulator kyty_launcher; do
        [ -f "$stage/$executable" ] \
            || fail "binaire $executable absent de l'archive Linux de $name"
    done
    if [ "$name" = "KytyPS5-U59" ] && [ ! -f "$stage/u59-preset.json" ]; then
        fail "u59-preset.json absent de l'archive Linux de $name"
    fi

    mkdir -p "$target" || fail "création du dossier d'installation impossible : $target"
    cp -a "$stage/." "$target/" || fail "copie des fichiers de $name impossible"
    chmod a+x "$target/kyty_emulator" "$target/kyty_launcher" \
        || fail "droits d'exécution impossibles à appliquer à $name"
    [ -x "$target/kyty_emulator" ] && [ -x "$target/kyty_launcher" ] \
        || fail "les exécutables de $name ne sont pas exécutables après installation"

    version_tmp="$(mktemp "$target/.release-version.XXXXXX")" \
        || fail "création du marqueur temporaire impossible pour $name"
    printf '%s\n%s\n' "$release_tag" "$release_digest" > "$version_tmp" \
        || { rm -f "$version_tmp"; fail "écriture du marqueur de version impossible pour $name"; }
    mv -f "$version_tmp" "$version_file" \
        || { rm -f "$version_tmp"; fail "installation du marqueur de version impossible pour $name"; }
    ok "$name installé (release $release_tag)"
}

install_emulators() (
    local WORK result=0
    WORK="$(mktemp -d /tmp/kyty-emulators.XXXXXX)" || fail "création du dossier temporaire impossible"
    trap 'rm -rf -- "$WORK"' EXIT
    (install_emulator_release \
        KytyPS5 \
        https://api.github.com/repos/KytyPS5/KytyPS5/releases/latest \
        "$DEST/system/ps5/emulator/KytyPS5") || result=1
    (install_emulator_release \
        KytyPS5-U59 \
        https://api.github.com/repos/Jetsku/KytyPS5/releases/latest \
        "$DEST/system/ps5/emulator/KytyPS5-U59") || result=1
    return "$result"
)

check_emulators() (
    command -v flock >/dev/null 2>&1 || { log "ERREUR : flock est nécessaire"; return 1; }
    exec 8>/tmp/kyty-install.lock || { log "ERREUR : création du verrou impossible"; return 1; }
    flock -n 8 || { log "ERREUR : une installation Kyty est déjà en cours"; return 1; }
    install_emulators
)

check_update() (
    local work remote local_v attempt result=0 integration_updated=0
    command -v flock >/dev/null 2>&1 || { log "ERREUR : flock est nécessaire"; return 1; }
    exec 9>/tmp/dcg_kyty_update.lock || return 1
    if ! flock -n 9; then
        log "Une vérification Kyty est déjà en cours"
        return 1
    fi
    work="$(mktemp -d /tmp/kyty-update.XXXXXX)" || {
        log "ERREUR : création du dossier temporaire impossible"
        return 1
    }
    trap 'rm -rf -- "$work"' EXIT

    remote=""
    for ((attempt=1; attempt<=30; attempt++)); do
        if download "$REPO_API/VERSION.txt?ref=main" "$work/VERSION.txt"; then
            remote="$(tr -d '\r\n[:space:]' < "$work/VERSION.txt")"
            [ -n "$remote" ] && break
        fi
        [ "$attempt" -eq 30 ] || sleep 2
    done
    if [[ ! "$remote" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log "ERREUR : version distante absente ou invalide : $remote"
        result=1
    else
        local_v="0.0.0"
        if [ -f "$VERSION_FILE" ]; then
            local_v="$(tr -d '\r\n[:space:]' < "$VERSION_FILE")"
        fi
        if [[ ! "$local_v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            log "ERREUR : version locale invalide : $local_v"
            result=1
        else
            log "Intégration : version locale $local_v, distante $remote"
            if [ "$remote" != "$local_v" ] && \
                [ "$(printf '%s\n%s\n' "$remote" "$local_v" | sort -V | tail -n 1)" = "$remote" ]; then
                if download "$REPO_API/install.sh?ref=main" "$work/install.sh" && \
                    bash "$work/install.sh" --update; then
                    integration_updated=1
                    log "Mise à jour de l'intégration terminée"
                else
                    log "ERREUR : mise à jour de l'intégration impossible"
                    result=1
                fi
            fi
        fi
    fi

    # Une installation complète vérifie déjà les deux releases.
    if [ "$integration_updated" -eq 0 ]; then
        if ! check_emulators; then
            log "ERREUR : vérification des releases Kyty impossible"
            result=1
        fi
    fi
    return "$result"
)

case "${1:-start}" in
    --emulators-only-locked)
        flock -n 8 || { log "ERREUR : verrou d'installation absent"; exit 1; }
        install_emulators
        ;;
    start)
        mkdir -p "$(dirname "$LOG")" || exit 1
        check_update >> "$LOG" 2>&1 &
        ;;
    scan|update)
        mkdir -p "$(dirname "$LOG")" || exit 1
        set -o pipefail
        check_update 2>&1 | tee -a "$LOG"
        ;;
    status)
        if [ -f "$VERSION_FILE" ]; then
            cat "$VERSION_FILE"
        else
            echo "Version Kyty inconnue : $VERSION_FILE absent" >&2
            exit 1
        fi
        ;;
    stop) ;;
    *)
        echo "Usage : $0 {start|stop|status|scan|update}" >&2
        exit 1
        ;;
esac
